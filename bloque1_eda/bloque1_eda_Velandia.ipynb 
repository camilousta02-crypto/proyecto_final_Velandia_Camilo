        "# ============================================\n",
        "# TAREA 2: Tres transformaciones analíticas\n",
        "# ============================================\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"TAREA 2: TRANSFORMACIONES ANALÍTICAS\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# TRANSFORMACIÓN 1: Precio promedio por Grupo y Año\n",
        "print(\"\\n--- Transformación 1: Precio promedio por Grupo y Año ---\")\n",
        "precio_grupo_anio = df_sipsa.groupBy(\"Grupo\", \"anio\") \\\n",
        "    .agg(\n",
        "        F.avg(\"Precio\").alias(\"precio_promedio\"),\n",
        "        F.count(\"*\").alias(\"n_registros\"),\n",
        "        F.stddev(\"Precio\").alias(\"desviacion\")\n",
        "    ) \\\n",
        "    .orderBy(\"Grupo\", \"anio\")\n",
        "\n",
        "precio_grupo_anio.show(20, truncate=False)\n",
        "\n",
        "# TRANSFORMACIÓN 2: Productos con precio mayor al percentil 95\n",
        "print(\"\\n--- Transformación 2: Productos de alto precio (P95) ---\")\n",
        "percentil_95 = df_sipsa.approxQuantile(\"Precio\", [0.95], 0.01)[0]\n",
        "print(f\"Percentil 95 del precio: ${percentil_95:,.0f}\")\n",
        "\n",
        "productos_alto_precio = df_sipsa.filter(F.col(\"Precio\") > percentil_95) \\\n",
        "    .groupBy(\"Producto\", \"Grupo\") \\\n",
        "    .agg(\n",
        "        F.avg(\"Precio\").alias(\"precio_avg\"),\n",
        "        F.count(\"*\").alias(\"frecuencia\")\n",
        "    ) \\\n",
        "    .orderBy(F.desc(\"precio_avg\"))\n",
        "\n",
        "productos_alto_precio.show(15, truncate=False)\n",
        "\n",
        "# TRANSFORMACIÓN 3: Variación interanual del precio por producto\n",
        "print(\"\\n--- Transformación 3: Variación interanual por Producto ---\")\n",
        "from pyspark.sql.window import Window\n",
        "\n",
        "window_spec = Window.partitionBy(\"Producto\", \"Ciudad\").orderBy(\"anio\")\n",
        "\n",
        "df_con_lag = df_sipsa.withColumn(\n",
        "    \"precio_anio_anterior\",\n",
        "    F.lag(\"Precio\", 1).over(window_spec)\n",
        ").withColumn(\n",
        "    \"variacion_interanual_pct\",\n",
        "    ((F.col(\"Precio\") - F.col(\"precio_anio_anterior\")) / F.col(\"precio_anio_anterior\") * 100)\n",
        ")\n",
        "\n",
        "variacion_producto = df_con_lag.filter(F.col(\"variacion_interanual_pct\").isNotNull()) \\\n",
        "    .groupBy(\"Producto\", \"Grupo\") \\\n",
        "    .agg(\n",
        "        F.avg(\"variacion_interanual_pct\").alias(\"var_avg_pct\"),\n",
        "        F.stddev(\"variacion_interanual_pct\").alias(\"var_std_pct\"),\n",
        "        F.count(\"*\").alias(\"n_observaciones\")\n",
        "    ) \\\n",
        "    .orderBy(F.desc(\"var_avg_pct\"))\n",
        "\n",
        "variacion_producto.show(15, truncate=False)"
