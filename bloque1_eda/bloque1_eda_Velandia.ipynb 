        "\n",
        "from pyspark.sql.window import Window\n",
        "\n",
        "# Ventana por Producto y Ciudad, ordenada por año\n",
        "window_lag = Window.partitionBy(\"Producto\", \"Ciudad\").orderBy(\"anio\")\n",
        "\n",
        "# Calcular precio del año anterior y variación\n",
        "df_con_variacion = df_sipsa \\\n",
        "    .groupBy(\"Producto\", \"Ciudad\", \"Grupo\", \"anio\") \\\n",
        "    .agg(F.round(F.avg(\"Precio\"), 2).alias(\"precio_anual_avg\")) \\\n",
        "    .withColumn(\"precio_anio_anterior\", F.lag(\"precio_anual_avg\", 1).over(window_lag)) \\\n",
        "    .withColumn(\n",
        "        \"variacion_interanual_pct\",\n",
        "        F.round(((F.col(\"precio_anual_avg\") - F.col(\"precio_anio_anterior\")) / F.col(\"precio_anio_anterior\") * 100), 2)\n",
        "    ) \\\n",
        "    .filter(F.col(\"variacion_interanual_pct\").isNotNull())\n",
        "\n",
        "print(\"\\n📊 Variación interanual por producto (primeras filas):\")\n",
        "df_con_variacion.select(\"Producto\", \"Ciudad\", \"anio\", \"precio_anual_avg\", \"precio_anio_anterior\", \"variacion_interanual_pct\") \\\n",
        "    .show(10, truncate=False)\n",
        "\n",
        "# Productos más volátiles (mayor desviación estándar de variación)\n",
        "print(\"\\n--- Productos más volátiles (mayor variación interanual promedio) ---\")\n",
        "volatilidad_producto = df_con_variacion \\\n",
        "    .groupBy(\"Producto\", \"Grupo\") \\\n",
        "    .agg(\n",
        "        F.avg(\"variacion_interanual_pct\").alias(\"var_avg_pct\"),\n",
        "        F.stddev(\"variacion_interanual_pct\").alias(\"var_std_pct\"),\n",
        "        F.count(\"*\").alias(\"n_observaciones\"),\n",
        "        F.max(\"variacion_interanual_pct\").alias(\"max_subida_pct\"),\n",
        "        F.min(\"variacion_interanual_pct\").alias(\"max_bajada_pct\")\n",
        "    ) \\\n",
        "    .filter(F.col(\"n_observaciones\") >= 3) \\\n",
        "    .orderBy(F.desc(\"var_std_pct\"))\n",
        "\n",
        "volatilidad_producto.show(15, truncate=False)\n",
        "\n",
        "# Estacionalidad: Precio promedio por mes (across all years)\n",
        "print(\"\\n--- Estacionalidad: Precio promedio por mes ---\")\n",
        "estacionalidad = df_sipsa \\\n",
        "    .groupBy(\"Grupo\", \"mes\") \\\n",
        "    .agg(F.round(F.avg(\"Precio\"), 0).alias(\"precio_mes_avg\")) \\\n",
        "    .orderBy(\"Grupo\", \"mes\")\n",
        "\n",
        "estacionalidad.show(30, truncate=False)\n",
        "\n",
        "# Variación estacional por grupo (coeficiente de variación mensual)\n",
        "print(\"\\n--- Variabilidad estacional por grupo ---\")\n",
        "cv_estacional = estacionalidad \\\n",
        "    .groupBy(\"Grupo\") \\\n",
        "    .agg(\n",
        "        F.round(F.avg(\"precio_mes_avg\"), 0).alias(\"precio_anual_avg\"),\n",
        "        F.round(F.stddev(\"precio_mes_avg\"), 0).alias(\"std_mensual\"),\n",
        "        F.round((F.stddev(\"precio_mes_avg\") / F.avg(\"precio_mes_avg\") * 100), 2).alias(\"cv_estacional_pct\")\n",
        "    ) \\\n",
        "    .orderBy(F.desc(\"cv_estacional_pct\"))\n",
        "\n",
        "cv_estacional.show(truncate=False)"
