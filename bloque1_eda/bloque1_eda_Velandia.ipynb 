      "source": [
        "# ============================================\n",
        "# PASO 3: Transformar Fecha y crear variables derivadas\n",
        "# ============================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"TRANSFORMACIONES: Fecha → Año, Mes, Día\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# Convertir Fecha de String a Date\n",
        "# Formato en Excel: \"1/01/2013\" → día/mes/año\n",
        "df_sipsa = df_sipsa.withColumn(\n",
        "    \"Fecha_Date\",\n",
        "    F.to_date(F.col(\"Fecha\"), \"d/MM/yyyy\")\n",
        ")\n",
        "\n",
        "# Extraer componentes temporales\n",
        "df_sipsa = df_sipsa \\\n",
        "    .withColumn(\"anio\", F.year(\"Fecha_Date\")) \\\n",
        "    .withColumn(\"mes\", F.month(\"Fecha_Date\")) \\\n",
        "    .withColumn(\"dia\", F.dayofmonth(\"Fecha_Date\")) \\\n",
        "    .withColumn(\"trimestre\", F.quarter(\"Fecha_Date\"))\n",
        "\n",
        "# Separar Fuente en Ciudad y Lugar\n",
        "df_sipsa = df_sipsa.withColumn(\n",
        "    \"Ciudad\",\n",
        "    F.split(F.col(\"Fuente\"), \",\").getItem(0)\n",
        ").withColumn(\n",
        "    \"Lugar\",\n",
        "    F.trim(F.split(F.col(\"Fuente\"), \",\").getItem(1))\n",
        ")\n",
        "\n",
        "# Mostrar resultado\n",
        "df_sipsa.select(\n",
        "    \"Fecha\", \"Fecha_Date\", \"anio\", \"mes\", \"trimestre\",\n",
        "    \"Grupo\", \"Producto\", \"Ciudad\", \"Lugar\", \"Precio\"\n",
        ").show(10, truncate=False)"
